{
  "name": "bear-in-kitchen",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "start": "astro dev",
    "build": "astro build",
    "check": "astro check",
    "preview": "astro preview",
    "db:generate-seed": "node scripts/generate-d1-seed.mjs",
    "db:seed": "npm run db:generate-seed && wrangler d1 execute bear-in-kitchen --remote --file database/seed.sql",
    "images:upload": "node scripts/upload-r2-images.mjs",
    "deploy": "npm run build && wrangler deploy",
    "test": "node --test tests/search.test.mjs",
    "test:build": "node --test tests/build.test.mjs"
  },
  "dependencies": {
    "@astrojs/sitemap": "^3.7.3",
    "@fontsource-variable/montserrat": "^5.3.0",
    "@fontsource-variable/playfair-display": "^5.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "astro": "^7.1.4",
    "tailwindcss": "^4.3.3"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^6.0.3",
    "wrangler": "^4.131.1"
  }
}
