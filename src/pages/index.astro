---
import BaseLayout from '../layouts/BaseLayout.astro';
import RecipeCard from '../components/RecipeCard.astro';
import { getRecipes } from '../lib/recipes';
import ingredientCatalog from '../data/ingredients.json';
const recipes = await getRecipes();
const categories = [...new Set(recipes.map(recipe => recipe.data.category))].sort((a, b) => a.localeCompare(b, 'cs'));
const usedIngredientIds = new Set(recipes.flatMap(recipe => recipe.data.ingredients.map(item => item.ingredientId)));
const ingredients = ingredientCatalog.filter(ingredient => usedIngredientIds.has(ingredient.id)).sort((a, b) => a.name.localeCompare(b.name, 'cs'));
---
<BaseLayout title="Recepty">
  <header class="page-intro">
    <p class="eyebrow">Z medvědí kuchyně</p>
    <h1>Dobré jídlo. Radost z každého sousta.</h1>
    <p class="lead">Něco sladkého ke kávě, něco dobrého na společný stůl. Najděte si recept, na který máte právě chuť.</p>
  </header>
  {recipes.length > 0 ? <>
    <section class="filters" id="recipe-filters" aria-labelledby="filter-heading" hidden>
      <div class="filter-heading">
        <div>
          <p class="eyebrow">Vyberte si</p>
          <h2 id="filter-heading">Najděte recept</h2>
        </div>
        <p>Hledejte podle názvu, kategorie nebo surovin, které máte doma.</p>
      </div>
      <div class="filter-fields">
        <label>Hledat recept<input id="recipe-search" type="search" placeholder="Název nebo ingredience…" /></label>
        <label>Kategorie<select id="recipe-category"><option value="">Všechny recepty</option>{categories.map(category => <option>{category}</option>)}</select></label>
      </div>
      <fieldset class="pantry-filter">
        <legend>Ingredience, které máte</legend>
        <div class="pantry-controls">
          <select id="ingredient-select" aria-label="Vyberte ingredienci">
            <option value="">Vyberte ingredienci…</option>
            {ingredients.map(ingredient => <option value={ingredient.id}>{ingredient.name}</option>)}
          </select>
          <button class="button button-primary" id="add-ingredient" type="button">Přidat ingredienci</button>
        </div>
        <div id="selected-ingredients" class="ingredient-chips" aria-live="polite"></div>
      </fieldset>
      <div class="filter-footer">
        <p id="recipe-count" role="status" aria-live="polite">Počet receptů: {recipes.length}</p>
        <button class="button button-quiet" id="reset-filters" type="button">Vymazat filtry</button>
      </div>
    </section>
    <div class="recipe-grid">{recipes.map(recipe => <RecipeCard recipe={recipe} />)}</div>
    <p id="no-results" hidden>Žádný recept neodpovídá hledání. Zkuste jiná slova nebo kategorii.</p>
  </> : <div class="prose mt-12"><h2>Recepty se připravují</h2><p>Brzy tu najdete inspiraci pro vaření a pečení.</p></div>}
</BaseLayout>

<script>
  import { matchesRecipe } from '../lib/search.mjs';
  const search = document.querySelector<HTMLInputElement>('#recipe-search');
  const category = document.querySelector<HTMLSelectElement>('#recipe-category');
  const ingredientSelect = document.querySelector<HTMLSelectElement>('#ingredient-select');
  const ingredientContainer = document.querySelector<HTMLElement>('#selected-ingredients');
  const addIngredientButton = document.querySelector<HTMLButtonElement>('#add-ingredient');
  const cards = [...document.querySelectorAll<HTMLElement>('[data-recipe]')];
  if (search && category && ingredientSelect && ingredientContainer && addIngredientButton) {
    document.querySelector<HTMLElement>('#recipe-filters')!.hidden = false;
    const params = new URLSearchParams(location.search);
    const ingredientNames = new Map([...ingredientSelect.options].filter(option => option.value).map(option => [option.value, option.text]));
    const selectedIngredients = new Set(params.getAll('ingredient').filter(id => ingredientNames.has(id)));
    search.value = params.get('q') ?? '';
    category.value = params.get('category') ?? '';
    const renderIngredients = () => {
      ingredientContainer.replaceChildren(...[...selectedIngredients].map(id => {
        const button = document.createElement('button');
        button.type = 'button';
        button.className = 'ingredient-chip';
        button.textContent = `${ingredientNames.get(id)} ×`;
        button.setAttribute('aria-label', `Odebrat ingredienci ${ingredientNames.get(id)}`);
        button.addEventListener('click', () => { selectedIngredients.delete(id); renderIngredients(); filter(); });
        return button;
      }));
      for (const option of ingredientSelect.options) option.disabled = selectedIngredients.has(option.value);
    };
    const filter = () => {
      let count = 0;
      for (const card of cards) {
        const visible = matchesRecipe(card.dataset.search ?? '', card.dataset.category ?? '', search.value, category.value, (card.dataset.ingredients ?? '').split(' ').filter(Boolean), [...selectedIngredients]);
        card.hidden = !visible;
        if (visible) count++;
      }
      document.querySelector('#recipe-count')!.textContent = `Počet receptů: ${count}`;
      document.querySelector<HTMLElement>('#no-results')!.hidden = count > 0;
      const url = new URL(location.href);
      for (const [key, value] of [['q', search.value], ['category', category.value]]) {
        if (value) url.searchParams.set(key, value); else url.searchParams.delete(key);
      }
      url.searchParams.delete('ingredient');
      for (const ingredient of [...selectedIngredients].sort()) url.searchParams.append('ingredient', ingredient);
      history.replaceState(null, '', url);
    };
    search.addEventListener('input', filter);
    category.addEventListener('change', filter);
    addIngredientButton.addEventListener('click', () => {
      if (!ingredientSelect.value) return;
      selectedIngredients.add(ingredientSelect.value);
      ingredientSelect.value = '';
      renderIngredients();
      filter();
    });
    document.querySelector('#reset-filters')!.addEventListener('click', () => { search.value = ''; category.value = ''; selectedIngredients.clear(); renderIngredients(); filter(); });
    renderIngredients();
    filter();
  }
</script>
