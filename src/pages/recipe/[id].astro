---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import { getRecipes } from '../../lib/recipes';
import { categoryIcon, stepIcons } from '../../lib/recipe-icons';

export async function getStaticPaths() {
  return (await getRecipes()).map(recipe => ({ params: { id: recipe.id }, props: { recipe } }));
}
interface Props { recipe: CollectionEntry<'recipes'> }
const { recipe: { data } } = Astro.props;
let step = 0;
const steps = data.steps.map(item => ({ ...item, number: item.tip ? undefined : ++step }));
const structuredData = {
  '@context': 'https://schema.org', '@type': 'Recipe', name: data.title,
  description: data.description,
  ...(Astro.site && data.photo ? { image: [new URL(data.photo.src, Astro.site).href] } : {}),
  datePublished: data.published.toISOString(), recipeCategory: data.category,
  keywords: data.tags.join(', '), recipeYield: String(data.serves), totalTime: `PT${data.minutes}M`,
  recipeIngredient: data.ingredients.map(item => [item.quantity, item.unit, item.name].filter(Boolean).join(' ')),
  recipeInstructions: data.steps.filter(item => !item.tip).map(item => ({ '@type': 'HowToStep', text: item.content })),
};
---
<BaseLayout title={data.title} description={data.description} noindex={data.draft}>
  <a class="back-link no-print" href="/">← Všechny recepty</a>
  {data.draft && <p class="tip draft-notice">Náhled konceptu. Tento recept není publikovaný.</p>}
  <div class="recipe-overview-grid">
    <div class="recipe-visual">
      {data.photo
        ? <Image class="recipe-photo" src={data.photo} alt={data.photoAlt} width={720} widths={[420, 720, 960]} sizes="(max-width: 760px) 100vw, 50vw" loading="eager" />
        : <div class="recipe-photo recipe-image-placeholder" role="img" aria-label={`Fotografie receptu ${data.title} není dočasně dostupná`}>🍴</div>}
    </div>
    <article class="recipe-overview">
      <div class="overview-section"><h1>{data.title}</h1></div>
      <div class="overview-section recipe-description"><p>{data.description}</p></div>
      <div class="overview-section recipe-stats">
        <div><img src={categoryIcon(data.category)} width="38" height="38" alt="" /><span>{data.category}</span></div>
        <div><img src="/icons/008-clock-of-circular-shape-at-two-o-clock.svg" width="38" height="38" alt="" /><span>{data.minutes} minut</span></div>
        <div><img src="/icons/007-team.svg" width="38" height="38" alt="" /><span>{data.serves} porcí</span></div>
        <div><img src="/icons/043-wooden-spoon.svg" width="38" height="38" alt="" /><span>{data.difficulty}</span></div>
      </div>
      {data.tags.length > 0 && <div class="overview-section recipe-tags">{data.tags.join(' · ')}</div>}
      <button id="print-recipe" class="button button-primary no-print" type="button" hidden>Vytisknout recept</button>
    </article>
  </div>
  <hr class="recipe-divider" />
  <div class="recipe-body">
    <section class="ingredients" aria-labelledby="ingredients-heading">
      <div class="section-heading"><p class="eyebrow">Co budete potřebovat</p><h2 id="ingredients-heading">Ingredience</h2></div>
      <ul class="ingredient-list">{data.ingredients.map(item => <li class="content-card ingredient-item">
        <span class="ingredient-marker" aria-hidden="true"></span>
        <span class="ingredient-content">
          {(item.quantity || item.unit) && <span class="ingredient-amount">{item.quantity?.toLocaleString('cs')} {item.unit}</span>}
          <span class="ingredient-name">{item.name}</span>
        </span>
      </li>)}</ul>
    </section>
    <section aria-labelledby="steps-heading">
      <div class="section-heading"><p class="eyebrow">Krok za krokem</p><h2 id="steps-heading">Postup</h2></div>
      <ol class="steps">{steps.map(item => <li class:list={['timeline-item', { 'timeline-tip': item.tip }]}>
        <div class="timeline-badge"><img src={item.tip ? '/icons/004-idea.svg' : stepIcons[(item.number ?? 1) - 1] ?? '/icons/043-wooden-spoon.svg'} width="42" height="42" alt="" /></div>
        <div class="timeline-panel content-card">
          {item.tip && <strong>Tip</strong>}
          <p>{item.content}</p>
          {item.photo && <Image src={item.photo} alt={item.photoAlt ?? (item.tip ? 'Fotografie k tipu' : `Postup přípravy, krok ${item.number}`)} width={700} />}
        </div>
      </li>)}</ol>
    </section>
  </div>
  {!data.draft && <script is:inline type="application/ld+json" set:html={JSON.stringify(structuredData).replace(/</g, '\\u003c')} />}
</BaseLayout>
<script>
  const button = document.querySelector<HTMLButtonElement>('#print-recipe');
  if (button) { button.hidden = false; button.addEventListener('click', () => window.print()); }
</script>
