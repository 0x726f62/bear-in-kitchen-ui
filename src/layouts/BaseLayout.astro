---
import { site } from '../config/site';
import '@fontsource-variable/montserrat';
import '@fontsource-variable/playfair-display';
import '@fontsource-variable/playfair-display/wght-italic.css';
import '../styles/global.css';

interface Props { title?: string; description?: string; noindex?: boolean }
const { title, description = site.description, noindex = false } = Astro.props;
const pageTitle = title ? `${title} | ${site.name}` : site.name;
const canonical = Astro.site ? new URL(Astro.url.pathname, Astro.site) : undefined;
const year = new Date().getFullYear();
---
<!doctype html>
<html lang={site.language}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#242a2d" />
    {noindex && <meta name="robots" content="noindex" />}
    {canonical && <link rel="canonical" href={canonical} />}
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:type" content="website" />
    {canonical && <meta property="og:url" content={canonical} />}
    <link rel="icon" href="/favicon.png" type="image/png" />
    <title>{pageTitle}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Přejít na obsah</a>
    <header class="site-header">
      <div class="header-inner shell">
        <a class="brand" href="/" aria-label={`${site.name} — úvodní stránka`}>
          <img src="/icons/bear.svg" width="75" height="75" alt="" />
          <span>Bear <em>in the</em> Kitchen</span>
        </a>
        <nav aria-label="Hlavní navigace">
          {site.navigation.map(({ href, label }) => (
            <a href={href} data-login-link={href === '/login/' ? '' : undefined} aria-current={Astro.url.pathname === href ? 'page' : undefined}>{label}</a>
          ))}
          <div class="account-nav" data-account-nav hidden>
            <a class="profile-link" href="/login/" data-profile-link>
              <span class="profile-avatar" data-profile-avatar aria-hidden="true"></span>
              <span data-profile-name></span>
            </a>
            <form method="post" action="/auth/logout">
              <button class="nav-logout" type="submit">Odhlásit se</button>
            </form>
          </div>
        </nav>
      </div>
    </header>
    <main id="main" class="shell"><slot /></main>
    <footer class="site-footer">
      <div class="footer-inner shell">
        <p>Made with <span aria-label="láskou">♥</span> by Luci &amp; Rob</p>
        <p>© 2018–{year} {site.name}. All Rights Reserved</p>
        <p>
          Icons by <a href="https://www.flaticon.com/authors/roundicons">Roundicons</a> and
          <a href="https://www.flaticon.com/authors/freepik">Freepik</a> from
          <a href="https://www.flaticon.com/">Flaticon</a>
        </p>
      </div>
    </footer>
    <script>
      interface CurrentUser {
        displayName: string;
        photoUrl: string | null;
        role: 'USER' | 'EDITOR' | 'ADMIN';
      }

      const loginLink = document.querySelector<HTMLElement>('[data-login-link]');
      const accountNav = document.querySelector<HTMLElement>('[data-account-nav]');
      const profileLink = document.querySelector<HTMLAnchorElement>('[data-profile-link]');
      const profileName = document.querySelector<HTMLElement>('[data-profile-name]');
      const profileAvatar = document.querySelector<HTMLElement>('[data-profile-avatar]');

      if (loginLink && accountNav && profileLink && profileName && profileAvatar) {
        fetch('/api/auth/me', { headers: { accept: 'application/json' }, credentials: 'same-origin' })
          .then(response => response.ok ? response.json() as Promise<CurrentUser> : null)
          .then(user => {
            if (!user) return;
            profileName.textContent = user.displayName;
            profileLink.setAttribute('aria-label', `Profil uživatele ${user.displayName}, role ${user.role}`);
            profileLink.title = `Profil · ${user.role}`;
            if (user.photoUrl) {
              const image = document.createElement('img');
              image.src = user.photoUrl;
              image.alt = '';
              image.referrerPolicy = 'no-referrer';
              profileAvatar.replaceWith(image);
            } else {
              profileAvatar.textContent = Array.from(user.displayName.trim())[0]?.toLocaleUpperCase('cs') ?? '?';
            }
            loginLink.hidden = true;
            accountNav.hidden = false;
          })
          .catch(() => {});
      }
    </script>
  </body>
</html>
