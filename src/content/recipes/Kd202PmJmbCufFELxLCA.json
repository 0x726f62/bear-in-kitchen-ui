  "steps": [
    {
      "content": "Sušené houby namočíme do teplé vody. A na troše olivového oleje osmahneme omyté a nakrájené žampiony a šalotku nakrájenou na jemno.",
      "tip": false
    },
    {
      "content": "Cuketu zbavíme slupky, nakrájíme na malé kostičky a přidáme do pánve, osolíme, opepříme a okořeníme tymiánem.",
      "tip": false
    },
    {
      "content": "Dále přidáme rýži a promícháme. Vhodíme bujón a 2 hrnky vody. Vodu přidáváme postupně (celkem cca 1l). Do pánve přilijeme i vodu ze sušených hub a přidáme sušené houby.",
      "tip": false
    },
    {
      "content": "Ke konci vaření přidáme mražený hrášek. Poté parmezán a ještě lehce prohřejeme, ale už nevaříme.",
      "tip": false
    },
    {
      "content": "Ihned podáváme posypané parmezánem.",
      "tip": false
    }
  ]
