---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { recipeUrl } from '../lib/recipes';
import { categoryIcon } from '../lib/recipe-icons';
interface Props { recipe: { id: string; data: { title: string; description: string; draft: boolean; category: string; tags: string[]; photo?: ImageMetadata; photoAlt: string; ingredients: Array<{ ingredientId: string; name: string }> } } }
const { recipe } = Astro.props;
const { data } = recipe;
const searchText = [data.title, data.description, data.category, ...data.tags, ...data.ingredients.map(item => item.name)].join(' ');
---
<article class="recipe-card" data-recipe data-search={searchText} data-category={data.category} data-ingredients={data.ingredients.map(item => item.ingredientId).join(' ')}>
  <a href={recipeUrl(recipe.id)}>
    {data.photo
      ? <Image src={data.photo} alt={data.photoAlt} width={560} widths={[320, 560, 840]} sizes="(max-width: 480px) 100vw, (max-width: 760px) 50vw, 33vw" />
      : <div class="recipe-image-placeholder" role="img" aria-label={`Fotografie receptu ${data.title} není dočasně dostupná`}>🍴</div>}
    <div class="card-body">
      <p class="card-category"><img src={categoryIcon(data.category)} width="22" height="22" alt="" /> {data.category}{data.draft && ' · Náhled konceptu'}</p>
      <h2>{data.title}</h2>
    </div>
  </a>
</article>
